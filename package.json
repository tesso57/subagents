{
  "name": "pi-subagents-from-scratch",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^26.6.6",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "description": "Delegate tasks to repository-defined Pi subagents with configurable concurrency and worktree isolation",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "subagents"
  ],
  "files": [
    "extensions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tesso57/subagents.git"
  },
  "homepage": "https://github.com/tesso57/subagents#readme",
  "bugs": {
    "url": "https://github.com/tesso57/subagents/issues"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "import-meta-resolve": "^4.2.0"
  }
}
